<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Helpers (Electron helpers, utilityProcess worker, llama-server, node-llama-cpp
         natives) inherit the app's sandbox. Apple rejects anything beyond these two keys
         on an inheriting executable, so they get their rights from the parent -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
