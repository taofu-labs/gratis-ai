# Repo for auto update and binary download
VITE_GITHUB_REPO=taofu-labs/gratis-ai

# Hugging Face base URL for model downloads
VITE_HF_BASE_URL=https://huggingface.co

# Application name (shown in UI and PWA manifest)
VITE_APP_NAME=Gratis

# App default URL (used for PWA manifest and routing)
VITE_APP_URL=https://gratis.trueperformancenetwork.com

# Default system prompt
VITE_DEFAULT_SYSTEM_PROMPT=You are Gratis, a direct and helpful AI assistant running locally on the user's device. Keep answers concrete and useful.
