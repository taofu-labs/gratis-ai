{
    "name": "gratisai",
    "version": "0.42.0",
    "description": "Privacy-first, offline-capable local LLM chat application",
    "repository": {
        "type": "git",
        "url": "https://github.com/actuallymentor/gratis-ai.git"
    },
    "main": "out/main/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "dev:electron": "electron-vite dev",
        "build:electron": "electron-vite build && electron-builder",
        "test": "playwright test --config=tests/playwright.config.js",
        "test:ui": "playwright test --ui --config=tests/playwright.config.js",
        "test:headed": "playwright test --headed --config=tests/playwright.config.js",
        "test:unit": "vitest run tests/unit/",
        "lint": "eslint --fix src",
        "postinstall": "node scripts/ensure_platform_deps.js && node scripts/copy_wasm.js && node scripts/generate_speedtest_files.js",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource-variable/montserrat": "^5.3.0",
        "@fontsource-variable/nunito": "^5.3.0",
        "@wllama/wllama-compat": "3.6.0",
        "electron-updater": "^6.8.9",
        "i18next": "^26.4.0",
        "idb": "^8.0.3",
        "less-lazy": "^0.0.2",
        "lucide-react": "^1.33.0",
        "mentie": "^0.5.4",
        "node-llama-cpp": "^3.20.0",
        "parakeet.js": "^1.4.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^17.0.12",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.2",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "styled-components": "^6.5.3",
        "use-query-params": "^2.2.2",
        "uuid": "^14.0.2",
        "wllama64": "1.0.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@vitejs/plugin-react": "^5.2.0",
        "airier": "^0.1.1",
        "electron": "^43.4.1",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "vite": "^7.3.6",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11"
    }
}
