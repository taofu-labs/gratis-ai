{
    "name": "gratisai",
    "version": "0.47.0",
    "description": "Privacy-first, offline-capable local LLM chat application",
    "repository": {
        "type": "git",
        "url": "https://github.com/taofu-labs/gratis-ai.git"
    },
    "main": "out/main/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:native": "vite build --mode native && cap sync",
        "preview": "vite preview",
        "predev:electron": "node scripts/fetch_llama_server.js",
        "dev:electron": "electron-vite dev",
        "prebuild:electron": "node scripts/fetch_llama_server.js",
        "build:electron": "electron-vite build && electron-builder",
        "test": "playwright test --config=tests/playwright.config.js",
        "test:pwa": "playwright test --config=tests/pwa.config.js",
        "test:ui": "playwright test --ui --config=tests/playwright.config.js",
        "test:headed": "playwright test --headed --config=tests/playwright.config.js",
        "test:unit": "vitest run tests/unit/",
        "lint": "eslint --fix src",
        "postinstall": "node scripts/ensure_platform_deps.js && node scripts/copy_wasm.js",
        "prepare": "husky",
        "fetch:llama-server": "node scripts/fetch_llama_server.js"
    },
    "dependencies": {
        "@capacitor/android": "8.5.3",
        "@capacitor/core": "8.5.3",
        "@capacitor/ios": "8.5.3",
        "@capacitor/keyboard": "8.0.6",
        "@fontsource-variable/montserrat": "^5.3.0",
        "@fontsource-variable/nunito": "^5.3.0",
        "@huggingface/hub": "^2.17.8",
        "@wllama/wllama-compat": "3.8.1",
        "electron-updater": "^6.8.9",
        "gratis-native": "file:mobile/plugin",
        "hash-wasm": "^4.12.0",
        "i18next": "^26.5.3",
        "idb": "^8.0.4",
        "lucide-react": "^1.60.0",
        "mentie": "^0.5.4",
        "node-llama-cpp": "^3.22.2",
        "parakeet.js": "^1.4.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hot-toast": "^2.6.1",
        "react-i18next": "^17.1.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.4",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "styled-components": "^6.6.0",
        "unpdf": "^1.9.1",
        "use-query-params": "^2.2.2",
        "uuid": "^14.0.3",
        "wllama64": "1.1.1",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@capacitor/cli": "8.5.3",
        "@playwright/test": "^1.64.1",
        "@vitejs/plugin-react": "^6.1.2",
        "airier": "^0.1.1",
        "electron": "^45.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "eslint": "^9.39.5",
        "husky": "^9.1.7",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "wrangler": "4.151.3"
    },
    "allowScripts": {
        "esbuild": true,
        "node-llama-cpp": true,
        "workerd": true,
        "electron-winstaller": true,
        "protobufjs": false
    }
}
